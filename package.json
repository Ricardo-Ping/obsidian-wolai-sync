{
	"name": "obsidian-wolai-sync",
	"version": "1.2.0",
	"description": "Enhanced Obsidian plugin for incremental two-way sync with Wolai pages and databases",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts src/*.ts",
		"test": "node --test tests/*.test.mjs",
		"check": "npm run lint && npm run test && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"wolai",
		"sync",
		"markdown",
		"obsidian-plugin"
	],
	"author": "Ricardo_PING",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ricardo-Ping/obsidian-wolai-sync.git"
	},
	"bugs": {
		"url": "https://github.com/Ricardo-Ping/obsidian-wolai-sync/issues"
	},
	"homepage": "https://github.com/Ricardo-Ping/obsidian-wolai-sync#readme",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"gray-matter": "^4.0.3",
		"obsidian": "latest",
		"remark": "^14.0.3",
		"remark-math": "^5.1.1",
		"remark-parse": "^10.0.2",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"unified": "^11.0.5"
	}
}
